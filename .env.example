# Copy to .env and fill in. Required for db:push, seeding, and dev.

# MySQL connection (REQUIRED for drizzle + the app)
DATABASE_URL="mysql://root:password@127.0.0.1:3306/robots"

# Session / auth secret (any long random string; `openssl rand -base64 32`)
JWT_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Natural-language search tab (OpenAI). Other features work without it.
OPENAI_API_KEY=""

# App
NODE_ENV="development"
PORT="3000"
VITE_APP_TITLE="Robot Database & Query System"

# OAuth portal (only needed for the hosted Manus login flow; optional for local browsing)
VITE_APP_ID=""
VITE_OAUTH_PORTAL_URL=""
OAUTH_SERVER_URL=""
OWNER_OPEN_ID=""
